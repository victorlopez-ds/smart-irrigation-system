# =============================================================================
# Irridea — Variables de entorno (plantilla)
#
# Copiar a .env y rellenar con valores reales:
#   cp .env.example .env
#
# IMPORTANTE: .env contiene secretos y NO se versiona (ver .gitignore).
# =============================================================================

# ── API Keys ──────────────────────────────────────────────────────────────────
AEMET_API_KEY=                       # Alta gratuita en https://opendata.aemet.es
AEMET_MUNICIPIO=30030                # Codigo INE del municipio (30030 = Murcia)
WEATHER_LAT=38.028                   # Latitud para calculo Hargreaves ET0
WEATHER_LON=-1.490                   # Longitud (informativo)

# ── Base de datos (PostgreSQL para Airflow + MLflow) ──────────────────────────
POSTGRES_PASSWORD=change_me_strong_password

# ── Airflow ───────────────────────────────────────────────────────────────────
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_fernet_key_here
AIRFLOW_SECRET_KEY=your_secret_key_here
AIRFLOW_ADMIN_PASSWORD=admin

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── MQTT (broker Mosquitto) ───────────────────────────────────────────────────
MQTT_BROKER_HOST=mosquitto           # hostname dentro de docker-compose
MQTT_BROKER_PORT=1883
MQTT_USER=irridea
MQTT_PASS=change_me_mqtt_password
# ── Protocolo wiclouds ODINS ──────────────────────────────────────────────────
WICLOUDS_APIKEY=odins
WICLOUDS_SERIAL=IA0301G00000000004
WICLOUDS_API_BASE=https://riego.mimurcia.murcia.es/backend
WICLOUDS_API_TOKEN=                    # JWT de la API wiclouds
WICLOUDS_CTRL_FLOW=62b5ae654b36644a08d464ac
WICLOUDS_DEV_FLOW=62b5ae654b366462ced45f0c
WICLOUDS_CTRL_SOIL=64ccb0f4bb7b241ff2f8a41f
WICLOUDS_DEV_SOIL=64ccb0f4bb7b241561f8a415

# ── Sync-agent / model-distributor (bearer token edge -> central) ─────────────
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_TOKEN=change_me_sync_token

# ── Directorios ───────────────────────────────────────────────────────────────
DATA_DIR=data/raw_stream
MODELS_DIR=models

# Ruta absoluta del proyecto en el HOST (la usa DockerOperator desde Airflow
# para hacer bind-mounts en los contenedores de entrenamiento).
# Linux:   /home/user/irridea/prod
# Windows: C:/Users/user/irridea/prod
HOST_PROJECT_DIR=/opt/irridea/prod
